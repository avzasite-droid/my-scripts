-- 4. Fly Vars & Logic
local MOUSE = PLAYER:GetMouse()
local CAMERA = workspace.CurrentCamera
local FLYING = false
local SPEED = 5
local KEYS = {W = false, A = false, S = false, D = false, Space = false, Shift = false}
local CONNECTIONS = {}

local function CreateFly()
    local CHAR = PLAYER.Character or PLAYER.CharacterAdded:Wait()
    local HRP = CHAR:WaitForChild("HumanoidRootPart")
    local HUM = CHAR:WaitForChild("Humanoid")
    
    HUM.PlatformStand = true
    
    local FLY_FOLDER = Instance.new("Folder")
    FLY_FOLDER.Name = "Animate" -- Masquerade
    FLY_FOLDER.Parent = HRP
    
    local ATT0 = Instance.new("Attachment", HRP)
    local ATT1 = Instance.new("Attachment", HRP)
    
    local AP = Instance.new("AlignPosition")
    AP.MaxForce = math.huge
    AP.MaxVelocity = math.huge
    AP.Responsiveness = 200
    AP.Attachment0 = ATT0
    AP.Attachment1 = ATT1
    AP.Parent = FLY_FOLDER
    
    local AO = Instance.new("AlignOrientation")
    AO.MaxTorque = math.huge
    AO.Responsiveness = 200
    AO.Attachment0 = ATT0
    AO.Attachment1 = ATT1
    AO.Parent = FLY_FOLDER
    
    local BG = Instance.new("BodyGyro")
    BG.MaxTorque = Vector3.new(0, math.huge, 0)
    BG.P = 20000
    BG.D = 500
    BG.Parent = HRP
    
    local LOOP
    LOOP = game:GetService("RunService").Heartbeat:Connect(function()
        if not FLYING then LOOP:Disconnect() return end
        
        HUM.PlatformStand = true
        local MOVE_VEC = Vector3.new(
            (KEYS.A and -1 or 0) + (KEYS.D and 1 or 0),
            (KEYS.Space and 1 or 0) + (KEYS.Shift and -1 or 0),
            (KEYS.W and -1 or 0) + (KEYS.S and 1 or 0)
        )
        
        if MOVE_VEC.Magnitude > 0 then
            ATT1.CFrame = CAMERA.CFrame:ToObjectSpace(CFrame.new(MOVE_VEC.Unit * SPEED * 10))
        else
            ATT1.CFrame = ATT0.CFrame
        end
        BG.CFrame = CAMERA.CFrame
    end)
    
    table.insert(CONNECTIONS, LOOP)
end

local function ToggleFly()
    FLYING = not FLYING
    TB.Text = FLYING and "🛑 DISABLE FLY" or "🚀 ENABLE FLY"
    TB.BackgroundColor3 = FLYING and Color3.fromRGB(120, 40, 40) or Color3.fromRGB(40, 100, 40)
    TBUS.Color = FLYING and Color3.fromRGB(200, 60, 60) or Color3.fromRGB(70, 170, 70)
    
    if FLYING then
        spawn(CreateFly)
    else
        if PLAYER.Character then
            local HRP = PLAYER.Character:FindFirstChild("HumanoidRootPart")
            if HRP then
                local FOLDER = HRP:FindFirstChild("Animate")
                if FOLDER then FOLDER:Destroy() end
                local BGY = HRP:FindFirstChild("BodyGyro")
                if BGY then BGY:Destroy() end
            end
            local HUM = PLAYER.Character:FindFirstChild("Humanoid")
            if HUM then HUM.PlatformStand = false end
        end
        for _, conn in CONNECTIONS do
            if conn then pcall(conn.Disconnect, conn) end
        end
        CONNECTIONS = {}
    end
end

