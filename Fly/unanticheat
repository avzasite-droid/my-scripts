local mt = getrawmetatable(game)
local oldnc = mt.__namecall
setreadonly(mt, false)
mt.__namecall = newcclosure(function(self, ...)
    local method = getnamecallmethod()
    if method == "Kick" and self == game.Players.LocalPlayer then
        print("Anti-Kick: Blocked!")
        return
    end
    return oldnc(self, ...)
end)
setreadonly(mt, true)

local PLAYER = game.Players.LocalPlayer
hookmetamethod(game, "__index", function(self, key)
    if self == PLAYER.Character and PLAYER.Character:FindFirstChild("HumanoidRootPart") and (key == "Velocity" or key == "AssemblyLinearVelocity") then
        return Vector3.new(0, 16, 0)
    end
end)

